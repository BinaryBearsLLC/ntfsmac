<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.binarybears.ntfsmac.helper</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ntfsmac Helper</string>
	<key>CFBundleDisplayName</key>
	<string>ntfsmac Helper</string>
	<!-- SMJobBless installs this as one standalone TOOL executable, not as a resource bundle.
	     CFBundleIconFile is therefore intentionally absent: macOS only resolves that key from a
	     bundle's Resources directory and System Settings uses its generic tool icon here. Adding
	     a pretend icon key cannot affect Full Disk Access and would misdocument the artifact. -->
	<key>CFBundlePackageType</key>
	<string>TOOL</string>
	<key>CFBundleShortVersionString</key>
	<string>3.1.1</string>
	<key>CFBundleVersion</key>
	<string>3.1.1</string>
	<!--
	SMJobBless authorizes the *installing app* to bless this helper. The identifier-only
	compatibility requirement keeps local ad-hoc source builds usable; official artifacts are
	separately required and verified to carry the BinaryBears Developer ID team identity.
	-->
	<key>SMAuthorizedClients</key>
	<array>
		<string>identifier "com.binarybears.ntfsmac"</string>
	</array>
</dict>
</plist>
