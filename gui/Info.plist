<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.binarybears.ntfsmac</string>
	<!-- Required for a real .app bundle to launch — Finder/launchd read this to find the binary
	     inside Contents/MacOS/. Matches the `ntfsmac-gui` executable product in Package.swift and
	     the name build/package-app.sh copies it under. -->
	<key>CFBundleExecutable</key>
	<string>ntfsmac-gui</string>
	<key>CFBundleName</key>
	<string>ntfsmac</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Generated deterministically from brand/ntfsmac-icon.png by
	     build/sync-brand-assets.sh and copied by build/package-app.sh. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleShortVersionString</key>
	<string>3.1.2</string>
	<key>CFBundleVersion</key>
	<string>3.1.2</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- No Dock icon, no main window — menu-bar agent shape (L7, GUI-PLAN "App shape"). -->
	<key>LSUIElement</key>
	<true/>
	<!-- Fork-local automation entry point. It only reveals the existing menu-bar popover; it
	     performs no mount, helper, route, or packet-filter action. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.binarybears.ntfsmac.opengui</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>binarybears-ntfsmac</string>
			</array>
		</dict>
	</array>
	<!--
	Mirrors helper/Info.plist's SMAuthorizedClients: SMJobBless requires the trust pairing on
	both sides. The identifier-only compatibility requirement keeps local ad-hoc source builds
	usable; official artifacts are separately required and verified to carry the BinaryBears
	Developer ID team identity.
	-->
	<key>SMPrivilegedExecutables</key>
	<dict>
		<key>com.binarybears.ntfsmac.helper</key>
		<string>identifier "com.binarybears.ntfsmac.helper"</string>
	</dict>
</dict>
</plist>
